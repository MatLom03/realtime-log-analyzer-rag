# Variabili d'ambiente - RINOMINA questo file in .env
# NON committare .env su Git!

# ── LLM (Groq) ──────────────────────────────────────────────
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=qwen/qwen3.8-27b

# ── Embeddings (HuggingFace, locale — nessuna API key) ──────
HF_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector store ─────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
